<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<base href="/">
<meta name="description" content="Complete overview of all pages on Playnex.">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sitemap — Playnex</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="logo.png"><link rel="stylesheet" href="style.css">
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>

<%- include('partials/header', { subnavType: 'shopping', activeSubnav: '' }) %>

<main id="main-content">
<div class="page-intro">
  <h1>PlayNex Sitemap</h1>
</div>

<div class="sitemap-wrap">
  <ul class="tree">
    <li>
      <div class="node root"><span class="title">PlayNex</span></div>
      <ul>

        <!-- HOMEPAGE BRANCH -->
        <li>
          <div class="node root"><span class="title"><a href="homepage.html">Homepage</a></span></div>
          <ul>

            <!-- COMMUNITY -->
            <li>
              <div class="node module"><span class="title"><a href="forum.html">Community</a></span></div>
              <ul>
                <!-- FORUM -->
<li>
  <div class="node page"><span class="title"><a href="forum.html">Forum</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% threads.forEach(function(thread) { %>
        <div class="node detail"><span class="title">
          <a href="forum-detail.html?id=<%= thread.id %>"><%= thread.title %></a>
        </span></div>
      <% }); %>
    </div>
  </div>
</li>

                <!-- GAME RATING -->
<li>
  <div class="node page"><span class="title"><a href="/rating">Game Rating</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% games.forEach(function(game) { %>
        <div class="node detail"><span class="title"><a href="/game/<%= game.id %>"><%= game.name %></a></span></div>
      <% }); %>
    </div>
  </div>
</li>
<!-- BLOG -->
<li>
  <div class="node page"><span class="title"><a href="/blog">Blog</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% blogPosts.forEach(function(post) { %>
        <div class="node detail"><span class="title"><a href="/blog/<%= post.id %>"><%= post.title %></a></span></div>
      <% }); %>
    </div>
  </div>
</li>

            <!-- SHOPPING -->
            <li>
              <div class="node module"><span class="title"><a href="shopping.html">Shopping</a></span></div>
            </li>

            <!-- SHOPPING CART -->
            <li>
              <div class="node module"><span class="title"><a href="cart.html">Shopping Cart</a></span></div>
              <ul>
                <li>
                  <div class="node page"><span class="title"><a href="checkout.html">Checkout</a></span></div>
                  <ul>
                    <li>
                      <div class="node detail"><span class="title"><a href="confirmation.html">Confirmation</a></span></div>
                    </li>
                  </ul>
                </li>
              </ul>
            </li>

            <!-- WISHLIST -->
            <li>
              <div class="node module"><span class="title"><a href="wishlist.html">Wishlist</a></span></div>
            </li>

            <!-- PROFILE -->
            <li>
  <div class="node module"><span class="title"><a href="Profile.html">User Profile</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <div class="node page"><span class="title"><a href="Login.html">Login</a></span></div>
      <div class="node page"><span class="title"><a href="Login.html">Sign Up</a></span></div>
      <div class="node page"><span class="title"><a href="Login.html">Forgot Password</a></span></div>
    </div>
  </div>
</li>

        <!-- ADMIN BRANCH -->
        <li>
          <div class="node root"><span class="title"><a href="admin.html">Administration</a></span></div>
          <ul>
            <li>
              <div class="node detail"><span class="title"><a href="admin-detail.html">Admin Detail</a></span></div>
            </li>
          </ul>
        </li>

      </ul>
    </li>
  </ul>
</div>
</main>

<%- include('partials/footer') %>

<script src="public/js/header.js"></script>
</body>
</html>
