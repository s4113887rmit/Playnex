<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<base href="/">
<meta name="description" content="Complete overview of all pages on Playnex.">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sitemap — Playnex</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="logo.png"><link rel="stylesheet" href="style.css">
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>

<header class="topbar">
  <div class="topbar__inner">
    <a href="homepage.html" class="logo">
      <img src="logo.png" alt="Playnex" class="logo__img">
    </a>
    <nav class="primary-nav">
      <a href="homepage.html" class="primary-nav__link">Home</a>
      <a href="shopping.html" class="primary-nav__link">Shopping</a>
      <a href="wishlist.html" class="primary-nav__link">Wishlist</a>
      <div class="primary-nav__dropdown">
        <a href="forum.html" class="primary-nav__link">Community</a>
        <div class="primary-nav__menu">
          <a href="forum.html" class="primary-nav__sub">Forum</a>
          <a href="/rating" class="primary-nav__sub">Reviews</a>
<a href="/blog" class="primary-nav__sub">Blog</a>
        </div>
      </div>
    </nav>
    <div class="topbar__actions">
      <a href="cart.html" class="icon-btn" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.3" fill="currentColor"/><circle cx="18" cy="21" r="1.3" fill="currentColor"/></svg>
      </a>
      <a href="Login.html" class="btn btn--ghost btn--small">Log in</a>
      <a href="Login.html" class="btn btn--primary btn--small">Sign up</a>
    </div>
  </div>
  <nav class="subnav">
    <a href="shopping.html" class="subnav__link">All</a>
    <a href="shopping.html?cat=digital" class="subnav__link">Digital games</a>
    <a href="shopping.html?cat=merch" class="subnav__link">Physical merch</a>
    <a href="shopping.html?cat=deals" class="subnav__link">Deals</a>
    <a href="shopping.html?cat=free" class="subnav__link">Free this week</a>
  </nav>
</header>

<main id="main-content">
<div class="page-intro">
  <h1>PlayNex Sitemap</h1>
</div>

<div class="sitemap-wrap">
  <ul class="tree">
    <li>
      <div class="node root"><span class="title">PlayNex</span></div>
      <ul>

        <!-- HOMEPAGE BRANCH -->
        <li>
          <div class="node root"><span class="title"><a href="homepage.html">Homepage</a></span></div>
          <ul>

            <!-- COMMUNITY -->
            <li>
              <div class="node module"><span class="title"><a href="forum.html">Community</a></span></div>
              <ul>
                <!-- FORUM -->
<li>
  <div class="node page"><span class="title"><a href="forum.html">Forum</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% threads.forEach(function(thread) { %>
        <div class="node detail"><span class="title">
          <a href="forum-detail.html?id=<%= thread.id %>"><%= thread.title %></a>
        </span></div>
      <% }); %>
    </div>
  </div>
</li>

                <!-- GAME RATING -->
<li>
  <div class="node page"><span class="title"><a href="/rating">Game Rating</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% games.forEach(function(game) { %>
        <div class="node detail"><span class="title"><a href="/game/<%= game.id %>"><%= game.name %></a></span></div>
      <% }); %>
    </div>
  </div>
</li>
<!-- BLOG -->
<li>
  <div class="node page"><span class="title"><a href="/blog">Blog</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <% blogPosts.forEach(function(post) { %>
        <div class="node detail"><span class="title"><a href="/blog/<%= post.id %>"><%= post.title %></a></span></div>
      <% }); %>
    </div>
  </div>
</li>

            <!-- SHOPPING -->
            <li>
              <div class="node module"><span class="title"><a href="shopping.html">Shopping</a></span></div>
            </li>

            <!-- SHOPPING CART -->
            <li>
              <div class="node module"><span class="title"><a href="cart.html">Shopping Cart</a></span></div>
              <ul>
                <li>
                  <div class="node page"><span class="title"><a href="checkout.html">Checkout</a></span></div>
                  <ul>
                    <li>
                      <div class="node detail"><span class="title"><a href="confirmation.html">Confirmation</a></span></div>
                    </li>
                  </ul>
                </li>
              </ul>
            </li>

            <!-- WISHLIST -->
            <li>
              <div class="node module"><span class="title"><a href="wishlist.html">Wishlist</a></span></div>
            </li>

            <!-- PROFILE -->
            <li>
  <div class="node module"><span class="title"><a href="Profile.html">User Profile</a></span></div>
  <div class="node-group-wrap">
    <div class="node-group">
      <div class="node page"><span class="title"><a href="Login.html">Login</a></span></div>
      <div class="node page"><span class="title"><a href="Login.html">Sign Up</a></span></div>
      <div class="node page"><span class="title"><a href="Login.html">Forgot Password</a></span></div>
    </div>
  </div>
</li>

        <!-- ADMIN BRANCH -->
        <li>
          <div class="node root"><span class="title"><a href="admin.html">Administration</a></span></div>
          <ul>
            <li>
              <div class="node detail"><span class="title"><a href="admin-detail.html">Admin Detail</a></span></div>
            </li>
          </ul>
        </li>

      </ul>
    </li>
  </ul>
</div>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <a href="homepage.html" class="logo logo--footer"><img src="logo.png" alt="Playnex" class="logo__img"></a>
      <p class="site-footer__tagline">Digital games and physical merch, one store, one cart.</p>
    </div>
    <div class="site-footer__col">
      <h3>Support</h3>
      <a href="contact.html">Contact us</a>
      <a href="/sitemap">Sitemap</a>
    </div>
    <div class="site-footer__col">
      <h3>Company</h3>
      <a href="terms.html">Terms of service</a>
      <a href="privacy.html">Privacy policy</a>
    </div>
  </div>
  <div class="site-footer__bottom"><p>&copy; 2026 Playnex. All rights reserved.</p></div>
</footer>

<script src="public/js/header.js"></script>
</body>
</html>
