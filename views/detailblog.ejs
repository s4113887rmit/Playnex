<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="description" content="Read a blog post on Playnex.">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<title><%= post.title %> — Playnex</title>
<link rel="icon" href="/logo.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>
<header class="topbar">
  <div class="topbar__inner">
    <a href="homepage.html" class="logo">
      <img src="logo.png" alt="Playnex" class="logo__img">
    </a>
    <nav class="primary-nav">
      <a href="homepage.html" class="primary-nav__link">Home</a>
      <a href="shopping.html" class="primary-nav__link">Shopping</a>
      <a href="wishlist.html" class="primary-nav__link">Wishlist</a>
      <div class="primary-nav__dropdown">
        <a href="forum.html" class="primary-nav__link is-active">Community</a>
        <div class="primary-nav__menu">
          <a href="forum.html" class="primary-nav__sub">Forum</a>
          <a href="/blog" class="primary-nav__sub is-active">Blog</a>
        </div>
      </div>
    </nav>
    <div class="topbar__actions">
      <form class="search" role="search" action="shopping.html" method="get">
        <label for="site-search" class="visually-hidden">Search games, merch, tags</label>
        <svg viewBox="0 0 24 24" class="search__icon" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.6" y2="16.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="site-search" name="q" type="search" placeholder="Search games, merch, tags">
        <button type="submit" class="visually-hidden">Search</button>
      </form>
      <a href="wishlist.html" class="icon-btn" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S3 14.9 3 8.9C3 5.9 5.4 3.5 8.4 3.5c1.7 0 3.3.8 4.3 2.1a5.3 5.3 0 0 1 4.3-2.1C20 3.5 21.5 5.9 21.5 8.9c0 6-9.5 11.6-9.5 11.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      </a>
      <a href="cart.html" class="icon-btn" aria-label="Cart, 3 items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.3" fill="currentColor"/><circle cx="18" cy="21" r="1.3" fill="currentColor"/></svg>
      </a>
      <a href="Login.html" class="btn btn--ghost btn--small">Log in</a>
      <a href="Login.html" class="btn btn--primary btn--small">Sign up</a>
    </div>
  </div>
</header>

<main id="main-content">
  <div class="page-header"><h1>Blog</h1></div>

  <div class="article-wrap">
    <article class="article">
      <div class="article-head">
        <h2><%= post.title %></h2>
        <div class="article-meta">
          <span class="author"><%= post.authorName %></span>
          <span class="date"><%= date %></span>
          <span class="views"><%= post.views %> views</span>
        </div>
        <div class="post-tags">
          <% post.tags.forEach(function (t) { %>
            <a href="/blog?tag=<%= encodeURIComponent(t) %>" class="post-tag"><%= t %></a>
          <% }) %>
        </div>
      </div>

      <% if (post.image) { %>
        <div class="article-image">
          <img src="<%= post.image %>" alt="<%= post.title %>">
        </div>
      <% } %>

      <div class="article-body">
        <% blocks.forEach(function (block) { %>
          <% if (block.type === 'h2') { %><h2><%= block.text %></h2><% } else { %><p><%= block.text %></p><% } %>
        <% }) %>
      </div>

      <div class="article-actions" id="article-actions" hidden>
        <a href="/blog/<%= post.id %>/edit" class="btn btn--ghost btn--small">Edit</a>
        <form method="POST" action="/blog/<%= post.id %>/delete" id="delete-form" style="display:inline;">
          <input type="hidden" name="userId" id="delete-user-id" value="">
          <button type="submit" class="btn btn--danger btn--small" id="delete-btn">Delete</button>
        </form>
      </div>
    </article>

    <section class="comments">
      <h3><%= post.comments.length %> Comments</h3>

      <% post.comments.slice().reverse().forEach(function (c) { %>
        <div class="comment" data-comment-date="<%= c.date %>">
          <div class="comment-avatar"></div>
          <div class="comment-content">
            <div class="comment-meta">
              <span class="author"><%= c.authorName %></span>
              <span class="date"><%= c.date %></span>
              <form method="POST" action="/blog/<%= post.id %>/comment/<%= c.id %>/delete"
                    class="comment-delete" data-comment-author="<%= c.authorId || '' %>" hidden>
                <input type="hidden" name="userId" class="comment-user-id" value="">
                <button type="submit" class="comment-action comment-action--danger">Delete</button>
              </form>
            </div>
            <p><%= c.content %></p>
          </div>
        </div>
      <% }) %>

      <div class="form-errors" id="comment-errors" <%= commentErrors.length ? '' : 'hidden' %>>
        <% commentErrors.forEach(function (err) { %><li><%= err %></li><% }) %>
      </div>

      <form method="POST" action="/blog/<%= post.id %>/comment" class="comment-form" id="comment-form" novalidate>
        <input type="hidden" name="userId" id="comment-user-id" value="">
        <label for="comment-content" class="visually-hidden">Add a comment</label>
        <textarea id="comment-content" name="content" rows="3" placeholder="Add a comment..." maxlength="1000"></textarea>
        <span class="field-error" id="comment-error"></span>
        <button type="submit" class="btn btn--primary btn--small">Post comment</button>
      </form>
    </section>
  </div>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <a href="homepage.html" class="logo logo--footer">
        <img src="logo.png" alt="Playnex logo" class="logo__img">
      </a>
      <p class="site-footer__tagline">Digital games and physical merch, one store, one cart.</p>
    </div>
    <div class="site-footer__col">
      <h3>Support</h3>
      <a href="contact.html">Contact us</a>
      <a href="/sitemap">Sitemap</a>
    </div>
    <div class="site-footer__col">
      <h3>Company</h3>
      <a href="terms.html">Terms of service</a>
      <a href="privacy.html">Privacy policy</a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>&copy; 2026 Playnex. All rights reserved.</p>
  </div>
</footer>

<div id="confirm-modal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <p>Delete this post? This cannot be undone.</p>
    <div class="modal-actions">
      <button id="modal-cancel" class="btn btn--ghost btn--small">Cancel</button>
      <button id="modal-confirm" class="btn btn--danger btn--small">Delete</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var postAuthorId = "<%= post.authorId || '' %>";

  // ---- format comment dates as DD/MM/YYYY ----
  document.querySelectorAll('.comment[data-comment-date]').forEach(function (el) {
    var d = new Date(el.getAttribute('data-comment-date'));
    if (isNaN(d.getTime())) return;
    var dd = String(d.getDate()).padStart(2, '0');
    var mm = String(d.getMonth() + 1).padStart(2, '0');
    el.querySelector('.date').textContent = dd + '/' + mm + '/' + d.getFullYear();
  });

  // ---- logged-in behaviour: identity + ownership ----
  var user = null;
  try {
    user = JSON.parse(localStorage.getItem('playnex_user') || 'null');
  } catch (e) {}

  if (user) {
    document.getElementById('comment-user-id').value = user.id || '';
    document.getElementById('delete-user-id').value = user.id || '';
    if (postAuthorId && user.id && String(user.id) === postAuthorId) {
      document.getElementById('article-actions').hidden = false;
    }

    // comment delete buttons: visible to the comment owner or an admin
    document.querySelectorAll('.comment-delete').forEach(function (form) {
      form.querySelector('.comment-user-id').value = user.id || '';
      var author = form.getAttribute('data-comment-author');
      var isOwner = author && String(user.id) === author;
      if (isOwner || user.role === 'admin') form.hidden = false;
      form.addEventListener('submit', function (e) {
        if (!window.confirm('Delete this comment?')) e.preventDefault();
      });
    });
  }

  // ---- delete confirmation modal ----
  var deleteForm = document.getElementById('delete-form');
  var modal = document.getElementById('confirm-modal');
  if (deleteForm) {
    deleteForm.addEventListener('submit', function (e) {
      e.preventDefault();
      modal.style.display = 'flex';
    });
  }
  document.getElementById('modal-cancel').addEventListener('click', function () {
    modal.style.display = 'none';
  });
  document.getElementById('modal-confirm').addEventListener('click', function () {
    deleteForm.submit();
  });

  // ---- live comment validation ----
  var commentForm = document.getElementById('comment-form');
  var commentContent = document.getElementById('comment-content');
  var commentError = document.getElementById('comment-error');

  function validateComment() {
    var len = commentContent.value.trim().length;
    if (len === 0) { commentError.textContent = 'Comment cannot be empty.'; return false; }
    if (len > 1000) { commentError.textContent = 'Comment must be 1,000 characters or fewer.'; return false; }
    commentError.textContent = '';
    return true;
  }

  commentContent.addEventListener('input', validateComment);
  commentForm.addEventListener('submit', function (e) {
    if (!validateComment()) e.preventDefault();
  });
})();
</script>
<script src="/public/js/header.js"></script>
</body>
</html>
