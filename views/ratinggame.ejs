<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<base href="/">
<meta name="description" content="Read reviews and ratings for <%= game.name %> on Playnex.">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<title><%= game.name %> — Playnex</title>
<link rel="icon" href="/logo.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>
<header class="topbar">
  <div class="topbar__inner">
    <a href="homepage.html" class="logo">
      <img src="logo.png" alt="Playnex" class="logo__img">
    </a>

    <nav class="primary-nav">
      <a href="homepage.html" class="primary-nav__link">Home</a>
      <a href="shopping.html" class="primary-nav__link">Shopping</a>
      <a href="wishlist.html" class="primary-nav__link">Wishlist</a>
      <div class="primary-nav__dropdown">
        <a href="forum.html" class="primary-nav__link is-active">Community</a>
        <div class="primary-nav__menu">
          <a href="forum.html" class="primary-nav__sub">Forum</a>
          <a href="/rating" class="primary-nav__sub is-active">Reviews</a>
          <a href="/blog" class="primary-nav__sub">Blog</a>
        </div>
      </div>
    </nav>

    <div class="topbar__actions">
      <form class="search" role="search" action="shopping.html" method="get">
        <label for="site-search" class="visually-hidden">Search games, merch, tags</label>
        <svg viewBox="0 0 24 24" class="search__icon" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.6" y2="16.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="site-search" name="q" type="search" placeholder="Search games, merch, tags">
        <button type="submit" class="visually-hidden">Search</button>
      </form>

      <a href="wishlist.html" class="icon-btn" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S3 14.9 3 8.9C3 5.9 5.4 3.5 8.4 3.5c1.7 0 3.3.8 4.3 2.1a5.3 5.3 0 0 1 4.3-2.1C20 3.5 21.5 5.9 21.5 8.9c0 6-9.5 11.6-9.5 11.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      </a>
      <a href="cart.html" class="icon-btn" aria-label="Cart, 3 items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.3" fill="currentColor"/><circle cx="18" cy="21" r="1.3" fill="currentColor"/></svg>
      </a>

      <a href="Login.html" class="btn btn--ghost btn--small">Log in</a>
      <a href="Login.html" class="btn btn--primary btn--small">Sign up</a>
    </div>
  </div>

  <nav class="subnav">
    <a href="forum.html" class="subnav__link">Forum</a>
    <a href="/rating" class="subnav__link is-active">Reviews</a>
    <a href="/blog" class="subnav__link">Blog</a>
  </nav>
</header>

<main id="main-content">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/homepage.html">Home</a><span>/</span>
    <a href="/forum.html">Community</a><span>/</span>
    <a href="/rating">Reviews</a><span>/</span>
    <span aria-current="page"><%= game.name %></span>
  </nav>

  <div class="page-header"><h1><%= game.name %></h1></div>

  <div class="wrap">
    <div class="gameinfo">
      <img src="<%= game.image %>" alt="<%= game.name %> poster">
      <div class="info">
        <h2><%= game.name %></h2>
        <p>Genre: <%= game.genre %> | <%= game.releaseDate %></p>
        <br>
        <h3>Description: <%= game.description %></h3>
      </div>
      <div class="review-sum">
        <h2><%= avg.toFixed(1) %></h2>
        <div class="sum-star">
          <% for (let i = 1; i <= 5; i++) { %>
            <span class="fa fa-star <%= i <= Math.round(avg) ? 'checked' : '' %>"></span>
          <% } %>
        </div>
        <p><%= count %> user reviews</p>
        <a class="btn btn--primary btn--small" href="/game/<%= game.id %>/review">Write review</a>
      </div>
    </div>

    <div class="detailreview">
      <div class="revieweva">
        <h2><%= avg.toFixed(1) %></h2>
        <div class="detail-star">
          <% for (let i = 1; i <= 5; i++) { %>
            <span class="fa fa-star <%= i <= Math.round(avg) ? 'checked' : '' %>"></span>
          <% } %>
        </div>
        <h3><%= count %> user reviews</h3>
      </div>
      <div class="rating-bars">
        <% for (let star = 5; star >= 1; star--) { %>
          <div class="rating-row">
            <span class="rating-label"><%= star %></span>
            <div class="bar-track">
              <div class="bar-fill" style="--fill: <%= distribution[star] %>%"></div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="comments">
      <h3><%= game.reviews.length %> Comments</h3>
      <% game.reviews.slice().reverse().forEach(r => { %>
        <div class="comment">
          <div class="comment-avatar"></div>
          <div class="comment-content">
            <div class="comment-meta">
              <span class="author"><%= r.author %></span>
              <span class="date"><%= r.date %></span>
              <a href="/game/<%= game.id %>/review?edit=<%= r.id %>" class="comment-action review-owner-action" data-author-id="<%= r.authorId || '' %>">Edit</a>
              <form method="POST" action="/game/<%= game.id %>/review/<%= r.id %>/delete" class="delete-review-form review-owner-action" data-author-id="<%= r.authorId || '' %>" style="display:inline">
                <input type="hidden" name="userId" class="review-delete-user-id" value="">
                <button type="submit" class="comment-action comment-action--danger">Delete</button>
              </form>
            </div>
            <div class="sum-star">
              <% for (let i = 1; i <= 5; i++) { %>
                <span class="fa fa-star <%= i <= r.stars ? 'checked' : '' %>"></span>
              <% } %>
            </div>
            <p><strong><%= r.title %></strong><br><%= r.content %></p>
            <% if (r.image) { %>
              <img src="<%= r.image %>" alt="review image" class="comment-image">
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div id="confirmModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <p>Delete this review?</p>
      <div class="modal-actions">
        <button id="modalCancel" class="btn btn--ghost btn--small">Cancel</button>
        <button id="modalConfirm" class="btn btn--danger btn--small">Delete</button>
      </div>
    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <a href="homepage.html" class="logo logo--footer">
        <img src="logo.png" alt="Playnex Logo" class="logo__img">
      </a>
      <p class="site-footer__tagline">Digital games and physical merch, one store, one cart.</p>
    </div>
    <div class="site-footer__col">
      <h3>Support</h3>
      <a href="contact.html">Contact us</a>
      <a href="/sitemap">Sitemap</a>
    </div>
    <div class="site-footer__col">
      <h3>Company</h3>
      <a href="terms.html">Terms of service</a>
      <a href="privacy.html">Privacy policy</a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>&copy; 2026 Playnex. All rights reserved.</p>
  </div>
</footer>

<script>
  let formToSubmit = null;
  const modal = document.getElementById('confirmModal');

  try {
    const user = JSON.parse(localStorage.getItem('playnex_user') || 'null');
    document.querySelectorAll('.review-owner-action').forEach((el) => {
      const authorId = el.getAttribute('data-author-id');
      const isAdmin = user && user.role === 'admin';
      const isOwner = user && authorId && String(authorId) === String(user.id);
      if (!isAdmin && !isOwner) el.style.display = 'none';
    });
    if (user) {
      document.querySelectorAll('.review-delete-user-id').forEach((el) => {
        el.value = user.id || '';
      });
    }
  } catch (e) {}

  document.querySelectorAll('.delete-review-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      formToSubmit = form;
      modal.style.display = 'flex';
    });
  });

  document.getElementById('modalCancel').addEventListener('click', () => {
    formToSubmit = null;
    modal.style.display = 'none';
  });

  document.getElementById('modalConfirm').addEventListener('click', () => {
    if (formToSubmit) formToSubmit.submit();
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });
</script>
<script src="/public/js/header.js"></script>
</body>
</html>
