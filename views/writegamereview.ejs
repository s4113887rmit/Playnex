<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<base href="/">
<meta name="description" content="Write or edit a game review on Playnex.">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<title><%= review ? 'Edit review' : 'Write review' %> — Playnex</title>
<link rel="icon" href="/logo.png">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>
<%- include('partials/header', { activeNav: 'community', activeSubnav: 'reviews' }) %>

<main id="main-content">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/homepage.html">Home</a><span>/</span>
    <a href="/forum.html">Community</a><span>/</span>
    <a href="/rating">Reviews</a><span>/</span>
    <a href="/game/<%= game.id %>"><%= game.name %></a><span>/</span>
    <span aria-current="page"><%= review ? 'Edit review' : 'Write review' %></span>
  </nav>

  <div class="page-header"><h1><%= review ? 'Edit review' : 'Write review' %></h1></div>

  <div class="new-thread-wrap">
    <h2><%= game.name %></h2>

    <% if (typeof errors !== 'undefined' && errors.length) { %>
      <ul class="form-errors">
        <% errors.forEach(err => { %><li><%= err %></li><% }) %>
      </ul>
    <% } %>

    <form class="new-thread-form" method="POST" action="/game/<%= game.id %>/review" id="reviewForm" novalidate>
      <input type="hidden" name="userId" id="review-user-id" value="">
      <% if (review) { %>
        <input type="hidden" name="reviewId" value="<%= review.id %>">
      <% } %>

      <div class="field">
        <div class="star-input">
          <% for (let i = 5; i >= 1; i--) { %>
            <input type="radio" id="star<%= i %>" name="rating" value="<%= i %>"
                   <%= (review ? review.stars === i : i === 5) ? 'checked' : '' %> />
            <label for="star<%= i %>" class="fa fa-star"></label>
          <% } %>
        </div>

        <label for="title">Title</label>
        <input type="text" id="title" name="title" maxlength="80"
               value="<%= review ? review.title : '' %>"
               placeholder="Write your title...">
        <span class="field-error" id="titleError"></span>
      </div>

      <div class="field">
        <label for="content">Content</label>
        <textarea id="content" name="content" minlength="10" maxlength="2000"
                  placeholder="Write your content..."><%= review ? review.content : '' %></textarea>
        <span class="field-error" id="contentError"></span>
      </div>

      <div class="field">
        <label for="reviewImage">Illustration image (URL, optional)</label>
        <input type="url" id="reviewImage" name="image"
               value="<%= review ? review.image : '' %>" placeholder="https://...">
        <img id="imagePreview" src="" alt="" style="display:none;">
      </div>

      <button type="submit" class="btn btn--primary"><%= review ? 'Update' : 'Submit' %></button>
      <a href="/game/<%= game.id %>" class="btn btn--ghost">Cancel</a>
    </form>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  const form = document.getElementById('reviewForm');
  const titleInput = document.getElementById('title');
  const contentInput = document.getElementById('content');
  const imageInput = document.getElementById('reviewImage');
  const imagePreview = document.getElementById('imagePreview');
  const DRAFT_KEY = 'reviewDraft_<%= game.id %>_<%= review ? review.id : "new" %>';

  // send the logged-in user id so the server can set the review author
  try {
    const user = JSON.parse(localStorage.getItem('playnex_user') || 'null');
    if (user) document.getElementById('review-user-id').value = user.id || '';
  } catch (e) {}

  function validateTitle() {
    const err = document.getElementById('titleError');
    const v = titleInput.value.trim();
    if (!v) { err.textContent = 'Cant leave blank'; return false; }
    if (v.length > 80) { err.textContent = 'Title maximum 80 characters'; return false; }
    err.textContent = '';
    return true;
  }

  function validateContent() {
    const err = document.getElementById('contentError');
    const len = contentInput.value.trim().length;
    if (len < 10) { err.textContent = `The content must be at least 10 characters long. (now ${len})`; return false; }
    if (len > 2000) { err.textContent = 'The content must be no more than 2,000 characters long.'; return false; }
    err.textContent = '';
    return true;
  }

  titleInput.addEventListener('input', () => { validateTitle(); saveDraft(); });
  contentInput.addEventListener('input', () => { validateContent(); saveDraft(); });

  imageInput.addEventListener('input', () => {
    if (imageInput.value) {
      imagePreview.src = imageInput.value;
      imagePreview.style.display = 'block';
      imagePreview.onerror = () => { imagePreview.style.display = 'none'; };
    } else {
      imagePreview.style.display = 'none';
    }
    saveDraft();
  });

  form.addEventListener('submit', (e) => {
    const okTitle = validateTitle();
    const okContent = validateContent();
    if (!okTitle || !okContent) { e.preventDefault(); return; }
    localStorage.removeItem(DRAFT_KEY);
  });

  function saveDraft() {
    localStorage.setItem(DRAFT_KEY, JSON.stringify({
      title: titleInput.value,
      content: contentInput.value,
      image: imageInput.value,
      rating: form.querySelector('input[name="rating"]:checked')?.value
    }));
  }

  function loadDraft() {
    const raw = localStorage.getItem(DRAFT_KEY);
    if (!raw) return;
    try {
      const d = JSON.parse(raw);
      if (!titleInput.value) titleInput.value = d.title || '';
      if (!contentInput.value) contentInput.value = d.content || '';
      if (!imageInput.value) imageInput.value = d.image || '';
      if (d.rating) {
        const radio = form.querySelector(`input[name="rating"][value="${d.rating}"]`);
        if (radio) radio.checked = true;
      }
      imageInput.dispatchEvent(new Event('input'));
    } catch (e) {}
  }

  loadDraft();
</script>
<script src="/public/js/header.js"></script>
</body>
</html>
