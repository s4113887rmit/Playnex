<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.name %> — Playnex</title>
    <meta name="description" content="View the selected Playnex game listing and discover similar titles.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/logo.png">
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
<a class="skip-to-content" href="#main-content">Skip to main content</a>
    <header class="topbar">
      <div class="topbar__inner">
        <a href="homepage.html" class="logo" aria-label="Playnex home">
          <img src="logo.png" alt="Playnex" class="logo__img">
        </a>

        <nav class="primary-nav" aria-label="Main navigation">
          <a href="homepage.html" class="primary-nav__link">Home</a>
          <a href="shopping.html" class="primary-nav__link is-active">Shopping</a>
          <a href="wishlist.html" class="primary-nav__link">Wishlist</a>
          <div class="primary-nav__dropdown">
            <a href="forum.html" class="primary-nav__link">Community</a>
            <div class="primary-nav__menu">
              <a href="forum.html" class="primary-nav__sub">Forum</a>
              <a href="/rating" class="primary-nav__sub">Reviews</a>
<a href="/blog" class="primary-nav__sub">Blog</a>
            </div>
          </div>
        </nav>

        <div class="topbar__actions">
          <form class="search" role="search" action="shopping.html" method="get">
            <label for="site-search" class="visually-hidden">Search games, merch, tags</label>
            <svg viewBox="0 0 24 24" class="search__icon" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><line x1="21" y1="21" x2="16.6" y2="16.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input id="site-search" name="q" type="search" placeholder="Search games, merch, tags">
            <button type="submit" class="visually-hidden">Search</button>
          </form>

          <a href="wishlist.html" class="icon-btn" aria-label="Wishlist">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S3 14.9 3 8.9C3 5.9 5.4 3.5 8.4 3.5c1.7 0 3.3.8 4.3 2.1a5.3 5.3 0 0 1 4.3-2.1C20 3.5 21.5 5.9 21.5 8.9c0 6-9.5 11.6-9.5 11.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
          </a>
          <a href="cart.html" class="icon-btn" aria-label="Cart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="21" r="1.3" fill="currentColor"/><circle cx="18" cy="21" r="1.3" fill="currentColor"/></svg>
          </a>
          <a href="Login.html" class="btn btn--ghost btn--small">Log in</a>
          <a href="Login.html" class="btn btn--primary btn--small">Sign up</a>
        </div>
      </div>

      <nav class="subnav" aria-label="Categories">
        <a href="shopping.html" class="subnav__link is-active">All</a>
        <a href="shopping.html?cat=digital" class="subnav__link">Digital games</a>
        <a href="shopping.html?cat=merch" class="subnav__link">Physical merch</a>
        <a href="shopping.html?cat=deals" class="subnav__link">Deals</a>
        <a href="shopping.html?cat=free" class="subnav__link">Free this week</a>
        <a href="forum.html" class="subnav__link">Forums</a>
      </nav>
    </header>

    <main id="main-content" class="listing-page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="homepage.html">Home</a><span>/</span>
        <a href="shopping.html">Shopping</a><span>/</span>
        <span id="breadcrumb-game" aria-current="page"><%= game.name %></span>
      </nav>

      <section class="listing-hero">
        <div class="listing-hero__media">
          <img id="listing-image" src="<%= game.image %>" alt="<%= game.name %> poster">
        </div>

        <div class="listing-hero__content">
          <span class="eyebrow">Featured title</span>
          <h1 id="listing-title"><%= game.name %></h1>
          <div class="listing-hero__meta">
            <span id="listing-genre"><%= game.genre %></span>
            <span class="listing-hero__dot">•</span>
            <span id="listing-platforms"><%= (game.platforms || []).join(", ") %></span>
          </div>

          <div class="listing-hero__pricing">
            <span id="listing-price" class="listing-price">$<%= Number(game.price).toFixed(2) %></span>
            <% if (game.oldPrice) { %>
              <span id="listing-old-price" class="listing-price listing-price--old">$<%= Number(game.oldPrice).toFixed(2) %></span>
            <% } else { %>
              <span id="listing-old-price" class="listing-price listing-price--old"></span>
            <% } %>
          </div>

          <p id="listing-description" class="listing-hero__description"><%= game.description %></p>

          <div class="listing-hero__actions">
            <button id="listing-add-cart" type="button" class="btn btn--primary btn--large" data-game-slug="<%= slug %>">Add to cart</button>
            <button id="listing-add-wishlist" type="button" class="btn btn--outline btn--large" data-game-slug="<%= slug %>">Add to wishlist</button>
            <a id="listing-buy-now" href="checkout.html" class="btn btn--ghost btn--large">Buy now</a>
          </div>

          <ul class="listing-hero__facts">
            <li><span>Type</span><strong id="listing-type"><%= game.type %></strong></li>
            <li><span>Availability</span><strong id="listing-availability"><%= game.availability %></strong></li>
            <li><span>Release</span><strong id="listing-release"><%= game.releaseDate %></strong></li>
          </ul>
        </div>
      </section>

      <section class="listing-section">
        <div class="listing-section__heading">
          <h2>About this game</h2>
        </div>

        <div class="listing-section__grid">
          <div class="listing-copy">
            <p id="listing-long-description"><%= game.longDescription %></p>
            <ul id="listing-features" class="listing-features">
              <% (game.features || []).forEach(function (feature) { %>
                <li><%= feature %></li>
              <% }) %>
            </ul>
          </div>

          <aside class="listing-aside">
            <h3>Game details</h3>
            <dl class="listing-details">
              <div>
                <dt>Genre</dt>
                <dd id="detail-genre"><%= game.genre %></dd>
              </div>
              <div>
                <dt>Platform</dt>
                <dd id="detail-platforms"><%= (game.platforms || []).join(", ") %></dd>
              </div>
              <div>
                <dt>Edition</dt>
                <dd id="detail-edition"><%= game.edition %></dd>
              </div>
              <div>
                <dt>Included</dt>
                <dd id="detail-included"><%= game.included %></dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <div class="detailreview">
        <div class="revieweva">
          <h2><%= avg.toFixed(1) %></h2>
          <div class="detail-star">
            <% for (var i = 1; i <= 5; i++) { %>
              <span class="fa fa-star <%= i <= Math.round(avg) ? 'checked' : '' %>"></span>
            <% } %>
          </div>
          <h3><%= count %> user reviews</h3>
          <a href="/game/<%= game.id %>/review" class="review-sum-btn">Write review</a>
        </div>
        <div class="rating-bars">
          <% for (var star = 5; star >= 1; star--) { %>
            <div class="rating-row">
              <span class="rating-label"><%= star %></span>
              <div class="bar-track">
                <div class="bar-fill" style="--fill: <%= distribution[star] %>%"></div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="comments">
        <h3><%= game.reviews.length %> Comments</h3>
        <% game.reviews.slice().reverse().forEach(function (r) { %>
          <div class="comment">
            <div class="comment-avatar"></div>
            <div class="comment-content">
              <div class="comment-meta">
                <span class="author"><%= r.author %></span>
                <span class="date"><%= r.date %></span>
                <a href="/game/<%= game.id %>/review?edit=<%= r.id %>" class="comment-action">Edit</a>
                <form method="POST" action="/game/<%= game.id %>/review/<%= r.id %>/delete"
                      class="delete-review-form" style="display:inline">
                  <input type="hidden" name="userId" class="review-delete-user-id" value="">
                  <button type="submit" class="comment-action comment-action--danger">Delete</button>
                </form>
              </div>
              <div class="sum-star">
                <% for (var j = 1; j <= 5; j++) { %>
                  <span class="fa fa-star <%= j <= r.stars ? 'checked' : '' %>"></span>
                <% } %>
              </div>
              <p><strong><%= r.title %></strong><br><%= r.content %></p>
              <% if (r.image) { %>
                <img src="<%= r.image %>" alt="review image" class="comment-image">
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <div id="confirmModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
          <p>Delete this review?</p>
          <div class="modal-actions">
            <button id="modalCancel" class="btn btn--ghost btn--small">Cancel</button>
            <button id="modalConfirm" class="btn btn--danger btn--small">Delete</button>
          </div>
        </div>
      </div>

      <section class="listing-section">
        <div class="listing-section__heading">
          <h2>Games you may like</h2>
        </div>
        <ul id="related-list" class="listing-related list-reset">
          <% related.forEach(function (item) { %>
            <li>
              <article class="listing-related__card">
                <a href="/listing/<%= item.id %>" class="listing-related__art" aria-label="View <%= item.name %>">
                  <img src="<%= item.image %>" alt="<%= item.name %> poster">
                </a>
                <div class="listing-related__body">
                  <h3><a href="/listing/<%= item.id %>"><%= item.name %></a></h3>
                  <p><%= item.genre %></p>
                  <div class="listing-related__price-row">
                    <span>$<%= Number(item.price).toFixed(2) %></span>
                  </div>
                </div>
              </article>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__col">
          <a href="homepage.html" class="logo logo--footer">
            <img src="logo.png" alt="Playnex logo" class="logo__img">
          </a>
          <p class="site-footer__tagline">Digital games and physical merch, one store, one cart.</p>
        </div>

        <div class="site-footer__col">
          <h3>Store</h3>
          <a href="shopping.html?cat=digital">Digital games</a>
          <a href="shopping.html?cat=merch">Physical merch</a>
          <a href="shopping.html?cat=deals">Deals</a>
          <a href="shopping.html?cat=free">Free this week</a>
        </div>

        <div class="site-footer__col">
          <h3>Community</h3>
          <a href="forum.html">Forums</a>
          <a href="/rating">Reviews</a>
          <a href="/blog">Blog</a>
          <a href="/sitemap">Sitemap</a>
        </div>
      </div>

      <div class="site-footer__bottom">
        <p>&copy; 2026 Playnex. All rights reserved.</p>
      </div>
    </footer>

    <script>
      (function () {
        'use strict';

        try {
          var user = JSON.parse(localStorage.getItem('playnex_user') || 'null');
          if (user) {
            document.querySelectorAll('.review-delete-user-id').forEach(function (el) {
              el.value = user.id || '';
            });
          }
        } catch (e) {}

        var formToSubmit = null;
        var modal = document.getElementById('confirmModal');

        document.querySelectorAll('.delete-review-form').forEach(function (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            formToSubmit = form;
            modal.style.display = 'flex';
          });
        });

        document.getElementById('modalCancel').addEventListener('click', function () {
          formToSubmit = null;
          modal.style.display = 'none';
        });

        document.getElementById('modalConfirm').addEventListener('click', function () {
          if (formToSubmit) formToSubmit.submit();
        });

        modal.addEventListener('click', function (e) {
          if (e.target === modal) modal.style.display = 'none';
        });
      })();
    </script>
    <script src="/public/js/current-user.js"></script>
    <script src="/public/js/api.js"></script>
    <script src="/public/js/listing.js"></script>
    <script src="/public/js/header.js"></script>
  </body>
</html>
